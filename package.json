{
  "name": "mobile-factory",
  "private": true,
  "version": "0.1.0",
  "description": "Jeu d'usine 2D pour mobile, TypeScript et PixiJS v8.",
  "type": "module",
  "homepage": "https://cardona.digital/mobile-factory/",
  "author": {
    "name": "Salvador Cardona",
    "url": "https://cardona.digital"
  },
  "license": "MIT",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:online": "vite --mode online",
    "dev:server": "npm run dev -w server",
    "dev:all": "concurrently --kill-others --names server,client --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:online\"",
    "build": "tsc --noEmit && vite build && npm run build -w server",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "art:sheet": "node src/tools/artSheet.ts",
    "art:brand": "node src/tools/brand.ts",
    "music:night": "node src/tools/music.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "pixi.js": "^8.20.1",
    "qrcode-generator": "^2.0.4"
  }
}
