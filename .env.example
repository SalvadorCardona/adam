# Variables du client, lues par Vite au build (copier en `.env.production.local`
# ou les passer à `npm run build`). Le serveur a les siennes : server/.env.example.

# L'URL du back-end. Absente, le jeu ne contacte personne et reste hors ligne —
# c'est le cas du build publié sur GitHub Pages aujourd'hui.
VITE_API_URL=

# Le vocal passe de navigateur à navigateur (WebRTC), par un STUN public. Derrière certains réseaux
# (4G, entreprise), il faut un relais TURN (coturn) : son adresse et ses identifiants, ici. Absents,
# le vocal reste sur le STUN seul. Voir docs/deploiement.md, « Vocal ».
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
