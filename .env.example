# Variables du client, lues par Vite au build (copier en `.env.production.local`
# ou les passer à `npm run build`). Le serveur a les siennes : server/.env.example.

# L'URL du back-end. Absente, le jeu ne contacte personne et reste hors ligne —
# c'est le cas du build publié sur GitHub Pages aujourd'hui.
VITE_API_URL=
