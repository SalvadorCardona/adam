# Configuration du serveur. Copier en `server/.env` pour le développement
# (`npm run dev:server` le lit s'il existe) ; en production, ce sont les
# variables d'environnement du conteneur. Toutes sont facultatives.

# Port HTTP et WebSocket (le même serveur). Le client de dev vise 8790 (.env.online).
PORT=8790

# Adresse d'écoute : 0.0.0.0 dans un conteneur, 127.0.0.1 pour n'écouter qu'en local.
HOST=0.0.0.0

# Fichier SQLite, relatif au dossier server/ en dev. L'image Docker le place
# dans le volume /data. `:memory:` donne une base jetable. Une base restée à
# l'ancien nom du jeu est renommée au démarrage (`adoptLegacyDatabase`).
DATABASE_PATH=data/adam.sqlite

# Origines du navigateur autorisées (CORS et WebSocket), séparées par des
# virgules ; `*` les accepte toutes, `http://localhost:*` cet hôte sur tout port.
# Absente : localhost et 127.0.0.1 sur tout port (le serveur de Vite en local),
# et les adresses publiques du jeu, nouvelles et ancienne (`config.ts`).
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Durée de validité d'une invitation à une partie, en minutes (1 à 1440).
INVITE_TTL_MINUTES=60

# E-mails (mot de passe oublié), par l'API transactionnelle de Brevo. Sans
# BREVO_API_KEY (dev, tests), l'e-mail est écrit dans les journaux du serveur
# au lieu de partir — le lien s'y copie — et le serveur démarre quand même.
BREVO_API_KEY=
# L'expéditeur : une adresse validée chez Brevo. Obligatoire avec BREVO_API_KEY.
MAIL_FROM=
# Son nom affiché ; « Adam » par défaut.
MAIL_FROM_NAME=Adam
# L'adresse publique du jeu : le lien de l'e-mail y mène (`?reset=<jeton>`).
# En dev, http://localhost:5173/adam/ ; par défaut, l'adresse en ligne.
PUBLIC_URL=https://hermez.dev/adam/
