{
  "name": "@mobile-factory/server",
  "private": true,
  "version": "0.1.0",
  "description": "Back-end de Mobile Factory : API HTTP, WebSocket et base SQLite.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
